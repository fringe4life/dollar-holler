{
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.16",
    "@ogygia/devtools": "0.12.0",
    "@opentelemetry/api": "1.10.0",
    "@sentry/sveltekit": "11.10.0",
    "@varlock/bitwarden-plugin": "2.0.2",
    "@varlock/cloudflare-integration": "1.6.3",
    "better-auth": "1.7.15",
    "drizzle-orm": "1.0.0-rc.5",
    "marked": "18.1.3",
    "ogygia": "0.12.2",
    "prismjs": "1.30.0",
    "sanitize-html": "2.18.1",
    "uuidv7": "1.2.1",
    "valibot": "1.5.0",
    "varlock": "1.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@eslint/js": "10.0.1",
    "@eslint/mcp": "0.3.16",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@pandacss/dev": "2.5.0",
    "@pandacss/eslint-plugin": "2.5.0",
    "@pandacss/mcp": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@pandacss/vite": "2.5.0",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/mcp": "0.1.29",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@varlock/vite-integration": "1.5.5",
    "@vitejs/devtools": "0.8.2",
    "bundlewatch": "1.1.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.0",
    "fallow": "3.38.1",
    "fontaine": "1.0.3",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "rollup-plugin-visualizer": "7.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-prettier": "5.0.3",
    "subset-font": "2.9.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "svelte-sitemap": "4.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-devtools-svelte": "0.7.0",
    "vite-plugin-devtools-json": "1.1.2",
    "wrangler": "4.157.0"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*",
    "#features": "./src/lib/features",
    "#features/*": "./src/lib/features/*",
    "#styled-system": "./styled-system",
    "#styled-system/*": "./styled-system/*"
  },
  "name": "dollar-holler",
  "scripts": {
    "dev": "bun run panda:build && bun vite dev",
    "build": "bun run panda:build && bun vite build",
    "analyze": "ANALYZE=true bun run build",
    "panda:build": "svelte-kit sync && panda build",
    "preview": "bun --bun vite preview",
    "prepare": "svelte-kit sync && husky",
    "lint": "eslint . --no-warn-ignored",
    "lint:fix": "eslint . --fix --no-warn-ignored",
    "format": "prettier --write . --experimental-cli",
    "format:check": "prettier --check . --experimental-cli",
    "stylelint": "stylelint \"src/**/*.css\"",
    "check": "bun run lint && bun run format:check && bun run stylelint && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "bun run panda:build && svelte-check --tsconfig ./tsconfig.json",
    "tsc": "./node_modules/@typescript/native/bin/tsc --noEmit",
    "tsc6": "./node_modules/typescript/bin/tsc --noEmit",
    "db:seed": "varlock run -- bun ./src/lib/server/db/seed.ts",
    "db:seed:remote": "varlock run -- node --import tsx ./src/lib/server/db/seed.ts --remote",
    "db:generate": "varlock run -- bun x drizzle-kit generate && bun scripts/flatten-d1-migrations.ts",
    "db:migrate": "wrangler d1 migrations apply dollar-holler --local",
    "db:migrate:remote": "wrangler d1 migrations apply dollar-holler --remote",
    "db:studio": "varlock run -- bun x drizzle-kit studio",
    "db:push": "varlock run -- bun x drizzle-kit push",
    "bench:sql-list": "bun ./scripts/sql-list-baseline.ts",
    "oracle:sql-list": "bun ./scripts/sql-list-baseline.ts --oracle",
    "oracle:sql-list:write": "bun ./scripts/sql-list-baseline.ts --write-oracle",
    "cf:types": "wrangler types ./src/worker-configuration.d.ts --include-runtime false",
    "cf:restore-workers": "bun scripts/restore-cloudflare-workers.ts",
    "fonts:subset-money": "bun ./scripts/subset-money-font.ts && prettier --write src/lib/fonts/money/money.css --experimental-cli",
    "deploy": "bun run build && varlock-wrangler deploy",
    "deploy:project": "varlock-wrangler deploy",
    "audit:deps": "bun audit --prod --audit-level=moderate",
    "dedupe": "bun dedupe",
    "dedupe:check": "bun dedupe --check",
    "ci:panda-fingerprint": "bun ./scripts/ci-panda-fingerprint.ts",
    "ci:bundlewatch": "bun ./scripts/ci-bundlewatch.ts",
    "fix": "bun run lint:fix && bun run format && bun run stylelint -- --fix",
    "env:typegen": "varlock typegen",
    "test": "bun test",
    "fallow:prepare": "bun run panda:build",
    "fallow": "bun run fallow:prepare && fallow",
    "fallow:dead-code": "bun run fallow:prepare && fallow dead-code",
    "fallow:boundaries": "bun run fallow:prepare && fallow list --boundaries",
    "fallow:boundary-violations": "bun run fallow:prepare && fallow dead-code --boundary-violations",
    "fallow:audit": "bun run fallow:prepare && fallow audit --gate new-only",
    "fallow:dupes": "bun run fallow:prepare && fallow dupes"
  },
  "type": "module",
  "version": "0.9.5",
  "private": true,
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "hono": "4.13.11",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "@sentry/bundler-plugins": {
      "glob": "14.0.3",
      "minimatch": "11.0.2"
    }
  },
  "trustedDependencies": [],
  "exports": {
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  }
}
