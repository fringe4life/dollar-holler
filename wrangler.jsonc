{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dollar-holler",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dolla-holla.org",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dollar-holler",
      "database_id": "08d44dec-3fb0-4ddc-bd6e-9d0b8aa8a185",
      "migrations_dir": "src/lib/server/db/d1",
    },
  ],
}
