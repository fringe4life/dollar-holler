# Dollar Holler — Varlock schema (committed).
# @generateTsTypes(path=./src/env-varlock.d.ts)
# @defaultSensitive=inferFromPrefix(PUBLIC_)
# @plugin(@varlock/bitwarden-plugin)
# @currentEnv=$VARLOCK_ENV
# @encryptInjectedEnv=forEnv(production)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# ---
# Machine account token (Bitwarden Secrets Manager). Set in `.env.local` or CI; omit if you override DB/auth secrets locally without Bitwarden.
# @type=bitwardenAccessToken
# @sensitive
# @required
BITWARDEN_ACCESS_TOKEN=
# @sensitive
# @type=string
# @required
# @docs(
#   "Signing secret for sessions and tokens",
#   https://www.better-auth.com/docs/installation
# )
BETTER_AUTH_SECRET=bitwarden("3f6a8182-0d80-46ce-b10c-b42b0026e464")
# @public
# @type=url(noTrailingSlash=true)
# @required
# @docs(
#   "baseURL and trustedOrigins",
#   https://www.better-auth.com/docs/installation
# )
PUBLIC_BASE_URL=http://localhost:5173
# Kit CSRF origin for server-island / remote form POSTs (must match the public site URL in prod).
# @public
# @type=url(noTrailingSlash=true)
# @required
# @docs(
#   "SvelteKit ORIGIN (CSRF)",
#   https://svelte.dev/docs/kit/configuration#csrf
# )
# @docs(
#   "ogygia production env",
#   https://ogygia.puruvj.dev/docs/start/install
# )
ORIGIN=if(forEnv(production), "https://dolla-holla.org", "http://localhost:5173")
# Stable HMAC for signed island holes across deploys (PPR). ≥16 UTF-8 bytes in production builds.
# @sensitive
# @type=string
# @required
# @docs(
#   "ogygia OGYGIA_SECRET",
#   https://ogygia.puruvj.dev/docs/start/install
# )
OGYGIA_SECRET=if(forEnv(production), bitwarden("b5f00ffb-67da-42b1-8587-b4f2010b76cf"), "local-dev-ogygia-secret-min-16b")
# @sensitive
# @type=string
# @required
# @docs(
#   "Auth token for source map uploads at build time",
#   https://docs.sentry.io/product/accounts/auth-tokens/
# )
# @docs(
#   "Sentry SvelteKit integration",
#   https://docs.sentry.io/platforms/javascript/guides/sveltekit/
# )
SENTRY_AUTH_TOKEN=bitwarden("ace04e9d-eec2-499a-9d96-b4490026cb7e")
# Optional. Needed for drizzle-kit studio/push against remote D1 (HTTP API).
# @optional
# @type=string
# @docs(
#   "Cloudflare account ID for D1 HTTP (drizzle-kit)",
#   https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
# )
CLOUDFLARE_ACCOUNT_ID=bitwarden("5b4a4abc-5174-4f51-b6ac-b482005cc07a")
# @optional
# @type=string
# @docs(
#   "D1 database UUID (wrangler d1 create / dashboard)",
#   https://developers.cloudflare.com/d1/get-started/
# )
CLOUDFLARE_D1_DATABASE_ID=bitwarden("f31e55fa-53d9-4232-a66f-b4a6002e5581")
# @optional
# @sensitive
# @type=string
# @docs(
#   "Cloudflare API token with D1 edit (drizzle-kit d1-http)",
#   https://developers.cloudflare.com/fundamentals/api/get-started/create-token/
# )
CLOUDFLARE_API_TOKEN=
